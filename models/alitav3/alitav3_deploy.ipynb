{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Alita v3 SageMaker Serverless Deployment\n",
    "\n",
    "This notebook deploys the Alita v3 classifier to AWS SageMaker Serverless Inference endpoints.\n",
    "\n",
    "**Prerequisites:**\n",
    "1. Model archive (.mar file) should be available in S3 or locally\n",
    "2. Docker image should be built and ready to push to ECR\n",
    "3. Appropriate IAM permissions for SageMaker, ECR, and S3"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import boto3\n",
    "import sagemaker\n",
    "from sagemaker import get_execution_role\n",
    "import time\n",
    "import json\n",
    "import base64\n",
    "from datetime import datetime"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Configuration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Configuration\n",
    "model_name = \"alitav3\"\n",
    "region = boto3.Session().region_name\n",
    "account_id = boto3.client('sts').get_caller_identity()['Account']\n",
    "\n",
    "# ECR repository\n",
    "ecr_repository = f\"{account_id}.dkr.ecr.{region}.amazonaws.com/{model_name}\"\n",
    "image_tag = \"latest\"\n",
    "image_uri = f\"{ecr_repository}:{image_tag}\"\n",
    "\n",
    "# SageMaker role\n",
    "role = get_execution_role()\n",
    "\n",
    "# Endpoint configurations\n",
    "batch_concurrency = 50  # Adjust based on your needs\n",
    "realtime_concurrency = 10  # Adjust based on your needs\n",
    "\n",
    "print(f\"Region: {region}\")\n",
    "print(f\"Account ID: {account_id}\")\n",
    "print(f\"Image URI: {image_uri}\")\n",
    "print(f\"Role: {role}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Build and Push Docker Image to ECR"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create ECR repository if it doesn't exist\n",
    "ecr_client = boto3.client('ecr')\n",
    "\n",
    "try:\n",
    "    ecr_client.create_repository(repositoryName=model_name)\n",
    "    print(f\"Created ECR repository: {model_name}\")\n",
    "except ecr_client.exceptions.RepositoryAlreadyExistsException:\n",
    "    print(f\"ECR repository {model_name} already exists\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build and push Docker image\n",
    "import subprocess\n",
    "import os\n",
    "\n",
    "# Change to model directory (adjust path as needed)\n",
    "model_dir = \"/home/ec2-user/SageMaker/animl-ml/models/alitav3\"\n",
    "os.chdir(model_dir)\n",
    "\n",
    "# Get ECR login token\n",
    "login_cmd = f\"aws ecr get-login-password --region {region} | docker login --username AWS --password-stdin {ecr_repository}\"\n",
    "subprocess.run(login_cmd, shell=True, check=True)\n",
    "\n",
    "# Build image\n",
    "build_cmd = f\"docker build -t {model_name}:{image_tag} .\"\n",
    "subprocess.run(build_cmd, shell=True, check=True)\n",
    "\n",
    "# Tag image\n",
    "tag_cmd = f\"docker tag {model_name}:{image_tag} {image_uri}\"\n",
    "subprocess.run(tag_cmd, shell=True, check=True)\n",
    "\n",
    "# Push image\n",
    "push_cmd = f\"docker push {image_uri}\"\n",
    "subprocess.run(push_cmd, shell=True, check=True)\n",
    "\n",
    "print(f\"Successfully pushed image to {image_uri}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Create SageMaker Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "sagemaker_client = boto3.client('sagemaker')\n",
    "\n",
    "# Create model\n",
    "model_name_sm = f\"{model_name}-{int(time.time())}\"\n",
    "\n",
    "create_model_response = sagemaker_client.create_model(\n",
    "    ModelName=model_name_sm,\n",
    "    PrimaryContainer={\n",
    "        'Image': image_uri,\n",
    "        'Mode': 'SingleModel'\n",
    "    },\n",
    "    ExecutionRoleArn=role\n",
    ")\n",
    "\n",
    "print(f\"Created model: {model_name_sm}\")\n",
    "print(f\"Model ARN: {create_model_response['ModelArn']}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Create Serverless Endpoint Configurations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Batch endpoint configuration\n",
    "batch_config_name = f\"{model_name}-batch-config-{int(time.time())}\"\n",
    "\n",
    "batch_config_response = sagemaker_client.create_endpoint_config(\n",
    "    EndpointConfigName=batch_config_name,\n",
    "    ProductionVariants=[\n",
    "        {\n",
    "            'VariantName': 'AllTraffic',\n",
    "            'ModelName': model_name_sm,\n",
    "            'ServerlessConfig': {\n",
    "                'MemorySizeInMB': 4096,\n",
    "                'MaxConcurrency': batch_concurrency\n",
    "            }\n",
    "        }\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(f\"Created batch endpoint config: {batch_config_name}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Real-time endpoint configuration\n",
    "realtime_config_name = f\"{model_name}-realtime-config-{int(time.time())}\"\n",
    "\n",
    "realtime_config_response = sagemaker_client.create_endpoint_config(\n",
    "    EndpointConfigName=realtime_config_name,\n",
    "    ProductionVariants=[\n",
    "        {\n",
    "            'VariantName': 'AllTraffic',\n",
    "            'ModelName': model_name_sm,\n",
    "            'ServerlessConfig': {\n",
    "                'MemorySizeInMB': 4096,\n",
    "                'MaxConcurrency': realtime_concurrency\n",
    "            }\n",
    "        }\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(f\"Created real-time endpoint config: {realtime_config_name}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Create Serverless Endpoints"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create batch endpoint\n",
    "batch_endpoint_name = f\"{model_name}-concurrency-{batch_concurrency}\"\n",
    "\n",
    "try:\n",
    "    batch_endpoint_response = sagemaker_client.create_endpoint(\n",
    "        EndpointName=batch_endpoint_name,\n",
    "        EndpointConfigName=batch_config_name\n",
    "    )\n",
    "    print(f\"Creating batch endpoint: {batch_endpoint_name}\")\n",
    "except Exception as e:\n",
    "    if \"already exists\" in str(e):\n",
    "        print(f\"Batch endpoint {batch_endpoint_name} already exists\")\n",
    "    else:\n",
    "        raise e"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create real-time endpoint\n",
    "realtime_endpoint_name = f\"{model_name}-realtime-concurrency-{realtime_concurrency}\"\n",
    "\n",
    "try:\n",
    "    realtime_endpoint_response = sagemaker_client.create_endpoint(\n",
    "        EndpointName=realtime_endpoint_name,\n",
    "        EndpointConfigName=realtime_config_name\n",
    "    )\n",
    "    print(f\"Creating real-time endpoint: {realtime_endpoint_name}\")\n",
    "except Exception as e:\n",
    "    if \"already exists\" in str(e):\n",
    "        print(f\"Real-time endpoint {realtime_endpoint_name} already exists\")\n",
    "    else:\n",
    "        raise e"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Wait for Endpoints to be Ready"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def wait_for_endpoint(endpoint_name, timeout_minutes=20):\n",
    "    \"\"\"Wait for endpoint to be in service\"\"\"\n",
    "    print(f\"Waiting for endpoint {endpoint_name} to be ready...\")\n",
    "    \n",
    "    start_time = time.time()\n",
    "    timeout_seconds = timeout_minutes * 60\n",
    "    \n",
    "    while True:\n",
    "        response = sagemaker_client.describe_endpoint(EndpointName=endpoint_name)\n",
    "        status = response['EndpointStatus']\n",
    "        \n",
    "        if status == 'InService':\n",
    "            print(f\"✓ Endpoint {endpoint_name} is ready!\")\n",
    "            return True\n",
    "        elif status == 'Failed':\n",
    "            print(f\"✗ Endpoint {endpoint_name} failed to deploy\")\n",
    "            print(f\"Failure reason: {response.get('FailureReason', 'Unknown')}\")\n",
    "            return False\n",
    "        \n",
    "        elapsed = time.time() - start_time\n",
    "        if elapsed > timeout_seconds:\n",
    "            print(f\"✗ Timeout waiting for endpoint {endpoint_name}\")\n",
    "            return False\n",
    "        \n",
    "        print(f\"  Status: {status} (elapsed: {elapsed/60:.1f}min)\")\n",
    "        time.sleep(30)\n",
    "\n",
    "# Wait for both endpoints\n",
    "batch_ready = wait_for_endpoint(batch_endpoint_name)\n",
    "realtime_ready = wait_for_endpoint(realtime_endpoint_name)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Test Endpoints"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test function\n",
    "def test_endpoint(endpoint_name, test_image_path=None):\n",
    "    \"\"\"Test the deployed endpoint\"\"\"\n",
    "    runtime_client = boto3.client('sagemaker-runtime')\n",
    "    \n",
    "    # Create a simple test payload\n",
    "    if test_image_path and os.path.exists(test_image_path):\n",
    "        with open(test_image_path, 'rb') as f:\n",
    "            image_data = f.read()\n",
    "        img_string = base64.b64encode(image_data).decode('utf-8')\n",
    "    else:\n",
    "        # Create a dummy image for testing\n",
    "        import numpy as np\n",
    "        from PIL import Image\n",
    "        import io\n",
    "        \n",
    "        # Create a random test image\n",
    "        test_img = np.random.randint(0, 255, (480, 480, 3), dtype=np.uint8)\n",
    "        pil_img = Image.fromarray(test_img)\n",
    "        \n",
    "        img_buffer = io.BytesIO()\n",
    "        pil_img.save(img_buffer, format='JPEG')\n",
    "        img_string = base64.b64encode(img_buffer.getvalue()).decode('utf-8')\n",
    "    \n",
    "    payload = {\n",
    "        \"image\": img_string,\n",
    "        \"bbox\": [0, 0, 1, 1]  # Full image\n",
    "    }\n",
    "    \n",
    "    try:\n",
    "        response = runtime_client.invoke_endpoint(\n",
    "            EndpointName=endpoint_name,\n",
    "            ContentType='application/json',\n",
    "            Body=json.dumps(payload)\n",
    "        )\n",
    "        \n",
    "        result = json.loads(response['Body'].read().decode())\n",
    "        print(f\"✓ Endpoint {endpoint_name} test successful!\")\n",
    "        \n",
    "        # Show top 3 predictions\n",
    "        if isinstance(result, list) and len(result) > 0:\n",
    "            predictions = result[0]\n",
    "        else:\n",
    "            predictions = result\n",
    "            \n",
    "        sorted_preds = sorted(predictions.items(), key=lambda x: x[1], reverse=True)\n",
    "        print(\"Top 3 predictions:\")\n",
    "        for i, (species, confidence) in enumerate(sorted_preds[:3]):\n",
    "            print(f\"  {i+1}. {species}: {confidence:.4f}\")\n",
    "        \n",
    "        return True\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"✗ Endpoint {endpoint_name} test failed: {e}\")\n",
    "        return False\n",
    "\n",
    "# Test both endpoints if they're ready\n",
    "if batch_ready:\n",
    "    print(\"\\n=== Testing Batch Endpoint ===\")\n",
    "    test_endpoint(batch_endpoint_name)\n",
    "\n",
    "if realtime_ready:\n",
    "    print(\"\\n=== Testing Real-time Endpoint ===\")\n",
    "    test_endpoint(realtime_endpoint_name)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Summary and Next Steps"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"\\n=== Deployment Summary ===\")\n",
    "print(f\"Model: {model_name_sm}\")\n",
    "print(f\"Image URI: {image_uri}\")\n",
    "\n",
    "if batch_ready:\n",
    "    print(f\"✓ Batch Endpoint: {batch_endpoint_name} (concurrency: {batch_concurrency})\")\n",
    "else:\n",
    "    print(f\"✗ Batch Endpoint: {batch_endpoint_name} - Failed or not ready\")\n",
    "\n",
    "if realtime_ready:\n",
    "    print(f\"✓ Real-time Endpoint: {realtime_endpoint_name} (concurrency: {realtime_concurrency})\")\n",
    "else:\n",
    "    print(f\"✗ Real-time Endpoint: {realtime_endpoint_name} - Failed or not ready\")\n",
    "\n",
    "print(\"\\n=== Next Steps ===\")\n",
    "print(\"1. Update SSM parameters in AWS Systems Manager:\")\n",
    "print(f\"   /ml/{model_name}-batch-endpoint-dev: {batch_endpoint_name}\")\n",
    "print(f\"   /ml/{model_name}-batch-endpoint-prod: {batch_endpoint_name}\")\n",
    "print(f\"   /ml/{model_name}-realtime-endpoint-dev: {realtime_endpoint_name}\")\n",
    "print(f\"   /ml/{model_name}-realtime-endpoint-prod: {realtime_endpoint_name}\")\n",
    "print(\"\\n2. Update animl-api to integrate the new model\")\n",
    "print(\"\\n3. Add MLModel record to MongoDB with species categories\")"
   ]
  }
